# Rendered by .github/workflows/release.yml on every tag; do not edit the copy
# in the tap by hand.
class Seedle < Formula
  desc "Deterministic, git-friendly database seed export and load"
  homepage "https://github.com/Delos-Intelligence/seedle"
  version "@VERSION@"
  license any_of: ["MIT", "Apache-2.0"]

  BASE = "https://github.com/Delos-Intelligence/seedle/releases/download/v@VERSION@".freeze

  on_macos do
    if Hardware::CPU.arm?
      url "#{BASE}/seedle-v@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA_MAC_ARM@"
    else
      url "#{BASE}/seedle-v@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA_MAC_X86@"
    end
  end

  on_linux do
    if Hardware::CPU.arm?
      url "#{BASE}/seedle-v@VERSION@-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA_LINUX_ARM@"
    else
      url "#{BASE}/seedle-v@VERSION@-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA_LINUX_X86@"
    end
  end

  def install
    bin.install "seedle"
  end

  test do
    assert_match "seedle #{version}", shell_output("#{bin}/seedle --version")

    # A config with a bad table/format combination must be rejected, which
    # exercises parsing and validation without needing a database.
    (testpath/"seedle.yaml").write <<~YAML
      version: 1
      sources:
        dev:
          engine: postgres
          url: postgres://localhost/nonexistent
      tables:
        users:
          format: json
    YAML
    output = shell_output("#{bin}/seedle sources --no-connect 2>&1", 1)
    assert_match "per_row", output
  end
end
